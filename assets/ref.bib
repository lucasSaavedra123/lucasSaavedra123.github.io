@inproceedings{barrantes2023,
   author = {Barrantes, Francisco José and Mosqueira, Alejo and Buena-Maizón, Héctor and Saavedra, Lucas Ariel},
   title = {The individual molecule and its tribe, the nanocluster: the case of the nicotinic acetylcholine receptor},
   booktitle = {11th International Weber Symposium},
   abstract = {Understanding synaptic function requires a detailed knowledge of the intervening molecular constituents. In the particular case of the peripheral cholinergic synapse (the neuromuscular junction), the nicotinic acetylcholine receptor (nAChR) plays a central role. We employ a combination of STED nanoscopy with single-molecule STORM superresolution localization microscopy to study the cell-surface topography and translational motion of this neurotransmitter receptor. At the single-track level, the free walks of an individual trajectory are transiently interrupted by confinement sojourns in small nanodomains (~50 nm radius), with millisecond-long lifetimes. The assembly of nAChR nanoclusters occurs in bursts lasting for seconds, separated by periods of cluster disassembly. The two dynamic processes occur in similar spatial scales, but in different time frames and with different cholesterol sensitivities. The ms-long confinement sojourns and the ms-long reversible nanoclustering affect all trajectories and determine the resulting macroscopic motional regime and the breadth of the heterogeneity in the ensemble population. The emerging picture is that the nAChR operates in a heterogeneous mixture of translational regimes: anomalous subdiffusive, Brownian and superdiffusive motions, and that these are subject to cholesterol modulation at the cell membrane.},
   year = {2023},
   address = {Punta del Este, Uruguay},
}

@inproceedings{saavedra20242,
   author = {Saavedra, Lucas Ariel and Barrantes, Francisco José},
   title = {Machine learning empowers static and dynamics clustering characterization of transmembrane receptors},
   booktitle = {Building Bridges in Computational Biophysics (BBCB) v3.0},
   abstract = {Most membrane-embedded proteins are not homogeneously distributed across the plasma membrane but are present as a mixture of isolated units and clusters of several units. Various tools from the field of machine-learning (ML) have been developed to analyze these clusters individually, at variance with ensemble methods that describe them globally. Unfortunately, most of the ML cluster analysis methods rely on user-defined parameters which are difficult to set if no a priori information is available about the underlying clustering mechanisms. Here, we show two ML parameter-free computational methods applicable to the analysis of both static and dynamic topography of transmembrane proteins. For static data, a geometric approach based on alpha-shapes termed ASTRICS in combination with STORMGraph was employed to analyze static clusters of stimulated emission depletion (STED) and stochastic optical reconstruction (STORM) superresolution microscopy images, showing its applicability to image- and single-molecule-based approaches. For dynamic data, a deep-learning, non-Euclidean, and data-driven approach was employed to construct graphs from STORM and total internal reflection fluorescence (TIRF) microscopy single-molecule localization microscopy (SMLM) datasets to decode dynamic clustering. As a proof-of-concept application, both methods were tested to investigate the distribution of the nicotinic acetylcholine receptor (nAChR) macromolecule in a native membrane environment. Despite the limitations of automatic dynamic clustering analysis, the two approaches presented here find useful applications in the analysis of clusters in biological membranes.},
   year = {2024},
}