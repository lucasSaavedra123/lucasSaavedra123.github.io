---
import { t, type Locale } from "../i18n/ui";
import type { ExperienceCategory, Profile } from "../data/profile";
import PdfIcon from "./PdfIcon.astro";

interface Props {
  locale: Locale;
  metadata: Profile;
}

const { locale, metadata } = Astro.props;
const roleLabel = metadata.personal.roles.join(" / ");

const MONTHS = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];

// Formatea una fecha "YYYY-MM" como "May 2025"; "YYYY" (sin mes) como "2025";
// y "present" como "Present".
function formatMonthYear(value: string): string {
  if (value.toLowerCase() === "present") return "Present";
  const [year, month] = value.split("-").map((part) => Number.parseInt(part, 10));
  if (!year) return value;
  if (!month) return String(year);
  return `${MONTHS[month - 1]} ${year}`;
}

// Rango de fechas: colapsa a un solo valor cuando inicio y fin coinciden
// (ej. "March 2024"), si no "May 2025 – Present" / "2018 – 2023".
function formatDateRange(start: string, end: string): string {
  const from = formatMonthYear(start);
  const to = formatMonthYear(end);
  return from === to ? from : `${from} – ${to}`;
}

function formatDate(value: string): string {
  const [year, month, day] = value.split("-").map((part) => Number.parseInt(part, 10));
  if (!year || !month || !day) return value;
  return `${day} ${MONTHS[month - 1]} ${year}`;
}

// Las tres subsecciones de experiencia, en orden, filtrando las vacías (ej.
// "research" queda vacío hasta que el usuario lo complete).
const EXPERIENCE_CATEGORIES: ExperienceCategory[] = ["research", "teaching", "industry"];
const experienceGroups = EXPERIENCE_CATEGORIES.map((category) => ({
  category,
  entries: metadata.experience.filter((entry) => entry.category === category),
})).filter((group) => group.entries.length > 0);

const hasInterests = metadata.interests.length > 0;

// El índice omite las secciones que no tienen contenido todavía (hoy, Interests
// mientras el usuario no la complete).
const sections = [
  { id: "contact", label: t(locale, "cv.section.contact") },
  { id: "summary", label: t(locale, "cv.section.summary") },
  { id: "education", label: t(locale, "cv.section.education") },
  { id: "experience", label: t(locale, "cv.section.experience") },
  { id: "skills", label: t(locale, "cv.section.skills") },
  { id: "certificates", label: t(locale, "cv.section.certificates") },
  { id: "courses", label: t(locale, "cv.section.courses") },
  ...(hasInterests ? [{ id: "interests", label: t(locale, "cv.section.interests") }] : []),
];
---

<div class="cv">
  <header class="cv__header">
    <div>
      <h1>{metadata.personal.display_name}</h1>
      {roleLabel && <p class="role">{roleLabel}</p>}
    </div>
    <div class="cv__downloads">
      <a class="btn btn--primary" href={metadata.cv_pdf_url} download>
        <PdfIcon />
        {t(locale, "cv.download.cv")}
      </a>
      <a class="btn btn--primary" href={metadata.resume_pdf_url} download>
        <PdfIcon />
        {t(locale, "cv.download.resume")}
      </a>
    </div>
  </header>

  <nav class="cv__toc" aria-label={t(locale, "nav.cv")}>
    <ul>
      {
        sections.map((section) => (
          <li>
            <a href={`#${section.id}`}>{section.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section id="contact" class="cv__section">
    <h2>{t(locale, "cv.section.contact")}</h2>
    <ul class="contact-list">
      <li>{metadata.personal.full_name}</li>
      {
        metadata.contact.emails.map((email) => (
          <li>
            <a href={`mailto:${email.address}`}>
              {email.label}: {email.address}
            </a>
          </li>
        ))
      }
      <li>{t(locale, "cv.contact.dob")}: {formatDate(metadata.personal.date_of_birth)}</li>
      {
        metadata.personal.nationalities.length > 0 && (
          <li>
            {t(locale, "cv.contact.nationalities")}:{" "}
            {metadata.personal.nationalities.join(", ")}
          </li>
        )
      }
      <li>{metadata.personal.location}</li>
    </ul>
  </section>

  <section id="summary" class="cv__section">
    <h2>{t(locale, "cv.section.summary")}</h2>
    <p>{metadata.summary.full}</p>
  </section>

  <section id="education" class="cv__section">
    <h2>{t(locale, "cv.section.education")}</h2>
    <ul class="timeline">
      {
        metadata.education.map((entry) => (
          <li class="timeline__entry">
            <span class="timeline__date">
              {formatDateRange(entry.start_date, entry.end_date)}
            </span>
            <div class="timeline__content">
              <p class="timeline__title">{entry.degree}</p>
              <p class="timeline__subtitle">
                {entry.institution} · {entry.location}
              </p>
              {entry.highlights.length > 0 && (
                <ul class="timeline__highlights">
                  {entry.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="experience" class="cv__section">
    <h2>{t(locale, "cv.section.experience")}</h2>
    {
      experienceGroups.map((group) => (
        <div class="experience-group">
          <h3>{t(locale, `cv.experience.${group.category}`)}</h3>
          <ul class="timeline">
            {group.entries.map((entry) => (
              <li class="timeline__entry">
                <span class="timeline__date">
                  {formatDateRange(entry.start_date, entry.end_date)}
                </span>
                <div class="timeline__content">
                  <p class="timeline__title">{entry.role}</p>
                  <p class="timeline__subtitle">
                    {entry.organization} · {entry.location}
                  </p>
                  {entry.highlights.length > 0 && (
                    <ul class="timeline__highlights">
                      {entry.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section id="skills" class="cv__section">
    <h2>{t(locale, "cv.section.skills")}</h2>
    <div class="skills-grid">
      {
        metadata.skills.map((group) => (
          <div class="skills-group">
            <h3>{group.category}</h3>
            <ul class="chip-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section id="certificates" class="cv__section">
    <h2>{t(locale, "cv.section.certificates")}</h2>
    <ul class="courses-list">
      {
        metadata.certificates.map((item) => (
          <li>
            <span class="courses-list__date">{item.date}</span>
            {item.name}
            {item.institution && <> — {item.institution}</>}
          </li>
        ))
      }
    </ul>
  </section>

  <section id="courses" class="cv__section">
    <h2>{t(locale, "cv.section.courses")}</h2>
    <ul class="courses-list">
      {
        metadata.courses.map((course) => (
          <li>
            <span class="courses-list__date">{course.date}</span>
            {course.name}
            {course.institution && <> — {course.institution}</>}
          </li>
        ))
      }
    </ul>
  </section>

  {
    hasInterests && (
      <section id="interests" class="cv__section">
        <h2>{t(locale, "cv.section.interests")}</h2>
        <ul class="chip-list">
          {metadata.interests.map((interest) => (
            <li>{interest}</li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .cv {
    max-width: 60rem;
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }

  .cv__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .cv__downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cv__header h1 {
    margin: 0 0 0.25rem;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }

  .role {
    margin: 0;
    color: var(--text-muted);
  }

  .cv__toc {
    margin-bottom: 2.5rem;
  }

  .cv__toc ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }

  .cv__section {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    scroll-margin-top: 5rem;
  }

  .cv__section h2 {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  .contact-list,
  .courses-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .courses-list__date {
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-right: 0.5rem;
  }

  .experience-group + .experience-group {
    margin-top: 1.5rem;
  }

  .experience-group h3 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .timeline__entry {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
  }

  @media (max-width: 560px) {
    .timeline__entry {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  .timeline__date {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .timeline__title {
    margin: 0;
    font-weight: 600;
  }

  .timeline__subtitle {
    margin: 0.15rem 0 0.5rem;
    color: var(--text-muted);
  }

  .timeline__highlights {
    margin: 0;
    padding-left: 1.1rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.25rem;
  }

  .skills-group h3 {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
  }
</style>
