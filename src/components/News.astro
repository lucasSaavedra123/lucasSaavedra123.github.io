---
import { t, type Locale } from "../i18n/ui";
import type { Profile } from "../data/profile";
import { formatNewsDate, sortNewsDescending } from "../lib/news";

interface Props {
  locale: Locale;
  metadata: Profile;
}

const { locale, metadata } = Astro.props;
const entries = sortNewsDescending(metadata.news);
---

<div class="news-page">
  <h1>{t(locale, "nav.news")}</h1>

  {
    entries.length > 0 ? (
      <ul class="news-list">
        {entries.map((entry) => (
          <li class="news-item">
            <time class="news-date" datetime={entry.date}>
              {formatNewsDate(entry.date)}
            </time>
            {entry.link ? (
              <a class="news-text" href={entry.link}>
                {entry.text}
              </a>
            ) : (
              <span class="news-text">{entry.text}</span>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="news-empty">{t(locale, "news.empty")}</p>
    )
  }
</div>

<style>
  .news-page {
    max-width: 60rem;
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }

  .news-page h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }

  .news-empty {
    margin: 0;
    color: var(--text-muted);
  }
</style>
