---
import { SOCIAL_ICONS, type SocialPlatformKey } from "../icons/social";

interface Props {
  platform: SocialPlatformKey;
}

const { platform } = Astro.props;
const icon = SOCIAL_ICONS[platform];
---

<svg class="social-icon" viewBox={icon.viewBox} aria-hidden="true" focusable="false">
  <path d={icon.path} fill="currentColor" />
</svg>

<style>
  .social-icon {
    width: 1.15em;
    height: 1.15em;
    display: block;
  }
</style>
