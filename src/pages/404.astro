---
import BaseLayout from "../layouts/BaseLayout.astro";
import { defaultLocale, t } from "../i18n/ui";

const title = t(defaultLocale, "error404.title");
---

<BaseLayout title={title} description={t(defaultLocale, "error404.message")}>
  <section class="not-found">
    <h1>{t(defaultLocale, "error404.title")}</h1>
    <p>{t(defaultLocale, "error404.message")}</p>
    <a class="btn btn--primary" href="/">{t(defaultLocale, "error404.backHome")}</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 40rem;
    margin: 0 auto;
    padding: 5rem 1.25rem;
    text-align: center;
  }

  .not-found h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  .not-found p {
    color: var(--text-muted);
    margin: 0 0 2rem;
  }
</style>
