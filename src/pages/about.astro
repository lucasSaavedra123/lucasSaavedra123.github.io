---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutMe from "../components/AboutMe.astro";
import { profile } from "../data/profile";
import { defaultLocale, t } from "../i18n/ui";

const title = `${t(defaultLocale, "nav.about")} — ${profile.personal.display_name}`;
---

<BaseLayout title={title} description={profile.summary.short}>
  <AboutMe metadata={profile} locale={defaultLocale} />
</BaseLayout>
