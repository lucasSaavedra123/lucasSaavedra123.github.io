---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/Contact.astro";
import { profile } from "../data/profile";
import { defaultLocale, t } from "../i18n/ui";

const title = `${t(defaultLocale, "nav.contact")} — ${profile.personal.display_name}`;
---

<BaseLayout title={title} description={profile.summary.short}>
  <Contact metadata={profile} locale={defaultLocale} />
</BaseLayout>
