---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cv from "../components/Cv.astro";
import { profile } from "../data/profile";
import { defaultLocale, t } from "../i18n/ui";

const title = `${t(defaultLocale, "nav.cv")} — ${profile.personal.display_name}`;
---

<BaseLayout title={title} description={profile.summary.short}>
  <Cv metadata={profile} locale={defaultLocale} />
</BaseLayout>
