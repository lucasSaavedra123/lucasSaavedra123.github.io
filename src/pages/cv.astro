---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cv from "../components/Cv.astro";
import { loadMetadata } from "../lib/metadata";
import { defaultLocale, t } from "../i18n/ui";

const metadata = loadMetadata(defaultLocale);
const title = `${t(defaultLocale, "nav.cv")} — ${metadata.personal.display_name}`;
---

<BaseLayout title={title} description={metadata.summary.short}>
  <Cv metadata={metadata} locale={defaultLocale} />
</BaseLayout>
