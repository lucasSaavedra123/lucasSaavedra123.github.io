---
// Home completa, movida acá temporalmente mientras "/" sirve la landing
// interina "Bajo construcción" (ver plan.md, Fase 9.5). Se restaura en "/"
// una vez terminadas las Fases 9 y 10.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import NewsPreview from "../components/NewsPreview.astro";
import { profile } from "../data/profile";
import { defaultLocale } from "../i18n/ui";
---

<BaseLayout
  title={profile.personal.display_name}
  description={profile.summary.short}
>
  <Hero metadata={profile} locale={defaultLocale} />
  <NewsPreview metadata={profile} locale={defaultLocale} />
</BaseLayout>
