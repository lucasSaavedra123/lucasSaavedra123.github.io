---
// Home completa, movida acá temporalmente mientras "/" sirve la landing
// interina "Bajo construcción" (ver plan.md, Fase 9.5). Se restaura en "/"
// una vez terminadas las Fases 9 y 10.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import NewsPreview from "../components/NewsPreview.astro";
import { loadMetadata } from "../lib/metadata";
import { defaultLocale } from "../i18n/ui";

const metadata = loadMetadata(defaultLocale);
---

<BaseLayout
  title={metadata.personal.display_name}
  description={metadata.summary.short}
>
  <Hero metadata={metadata} locale={defaultLocale} />
  <NewsPreview metadata={metadata} locale={defaultLocale} />
</BaseLayout>
