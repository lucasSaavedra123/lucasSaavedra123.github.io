---
import BaseLayout from "../layouts/BaseLayout.astro";
import News from "../components/News.astro";
import { profile } from "../data/profile";
import { defaultLocale, t } from "../i18n/ui";

const title = `${t(defaultLocale, "nav.news")} — ${profile.personal.display_name}`;
---

<BaseLayout title={title} description={profile.summary.short}>
  <News metadata={profile} locale={defaultLocale} />
</BaseLayout>
