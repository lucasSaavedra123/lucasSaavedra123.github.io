---
import BaseLayout from "../layouts/BaseLayout.astro";
import News from "../components/News.astro";
import { loadMetadata } from "../lib/metadata";
import { defaultLocale, t } from "../i18n/ui";

const metadata = loadMetadata(defaultLocale);
const title = `${t(defaultLocale, "nav.news")} — ${metadata.personal.display_name}`;
---

<BaseLayout title={title} description={metadata.summary.short}>
  <News metadata={metadata} locale={defaultLocale} />
</BaseLayout>
