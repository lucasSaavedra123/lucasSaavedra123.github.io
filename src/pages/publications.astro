---
import BaseLayout from "../layouts/BaseLayout.astro";
import Publications from "../components/Publications.astro";
import { profile } from "../data/profile";
import { getPublications } from "../lib/publications";
import { defaultLocale, t } from "../i18n/ui";

const publications = await getPublications();
const scholarUrl = profile.social.find(
  (entry) => entry.platform === "google_scholar"
)?.url;
const title = `${t(defaultLocale, "nav.publications")} — ${profile.personal.display_name}`;
---

<BaseLayout title={title} description={profile.summary.short}>
  <Publications publications={publications} locale={defaultLocale} scholarUrl={scholarUrl} />
</BaseLayout>
